{
  "name": "@runsnip/next-zones",
  "version": "0.1.0",
  "description": "Zones for Next.js: separately versioned apps composed into one Next app — one process, soft navigation across zones — and new zones loaded into a running server without a restart.",
  "license": "Apache-2.0",
  "author": {
    "name": "Nguyễn Văn Cảnh",
    "email": "hello@canhnguyen.vn",
    "url": "https://canhnguyen.vn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runsnip/next-zones.git"
  },
  "homepage": "https://github.com/runsnip/next-zones#readme",
  "keywords": [
    "next",
    "nextjs",
    "zones",
    "micro-frontends",
    "app-router"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": "16.3.6 || 16.3.7 || 16.3.8 || 16.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "tsconfig",
    "LICENSE",
    "NOTICE",
    "llms.txt",
    "llms-full.txt",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./zones": {
      "types": "./dist/zones/index.d.cts",
      "import": "./dist/zones/index.cjs",
      "require": "./dist/zones/index.cjs",
      "default": "./dist/zones/index.cjs"
    },
    "./build": {
      "types": "./dist/build.d.mts",
      "import": "./dist/build.mjs",
      "require": "./dist/build.mjs",
      "default": "./dist/build.mjs"
    },
    "./metrics": {
      "types": "./dist/metrics.d.cts",
      "import": "./dist/metrics.cjs",
      "require": "./dist/metrics.cjs",
      "default": "./dist/metrics.cjs"
    },
    "./sources": {
      "types": "./dist/sources.d.cts",
      "import": "./dist/sources.cjs",
      "require": "./dist/sources.cjs",
      "default": "./dist/sources.cjs"
    },
    "./tsconfig/zone.json": "./tsconfig/zone.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "next-zones": "./dist/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:zones": "node spikes/zones/check-all.mjs",
    "test:upgrade": "node tools/upgrade-guard.mjs",
    "llms": "node tools/llms.mjs",
    "build": "node tools/build-dist.mjs",
    "prepack": "node tools/build-dist.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13"
  }
}
